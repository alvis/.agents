#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: resolve-state-workspace [--work-id <id>|--work-id=<id>] \
         [--path <path>|--path=<path>] [--bootstrap]

Resolves the state workspace and selected work identity, enforcing the
.state ignore gate and path safety. A normal invocation is read-only;
--bootstrap is the PM-only no-clobber creation mode.

Output (JSON) on status:"resolved":
  vcs                 git | jj
  durable_root        active workspace root for versioned docs and repo files
  repo_root           compatibility alias of durable_root
  default_workspace   registered default tree (nullable discovery metadata)
  active_workspace    the tree the caller is working in
  state_root          the tree that owns .state/ — the default source
                      tree, falling back to active_workspace when no default
                      tree can be discovered
  work_id             the selected work identity
  work_id_source      argument | environment | workspace | sole_existing
  work_dir            the only temporary root for the selected work, always
                      under state_root/.state/works/
  ignore_file         the state_root .gitignore carrying the .state/ rule
  state_ignored true when the ignore gate holds
  bootstrap_requested / bootstrap_created / bootstrap_existing
                      bootstrap mode and its exact created/preserved paths

Other statuses: work_id_required (with work_id_grammar, naming_reference,
workspace_label, suggested_work_id, and existing_work_ids — every stream on
disk under works/ and archive/, to check a proposed ID against for collision,
never a set of format examples), requires_ignore (with ignore_file), invalid
(with error).
EOF
}

invalid() {
  jq -n --arg message "$1" '{status:"invalid", error:$message}'
  exit 2
}

# What any work ID may look like, including one minted under older rules.
# Reading an existing stream uses this, so a directory already on disk always
# resolves by its own name.
valid_work_id() {
  [[ "$1" =~ ^[a-z0-9]+([a-z0-9-]*[a-z0-9])?$ ]]
}

# What a *new* identity may look like. Shape only: a name outside this grammar
# does not survive the round trip through a path and a branch, so minting one
# is a defect rather than a style choice.
canonical_work_id() {
  [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]
}

# The 32-byte bound is a convention with a cost behind it, not a requirement,
# so it governs only what this resolver proposes; a PM who names a longer
# stream deliberately gets it.
within_id_bound() {
  [[ ${#1} -le 32 ]]
}

# 32 bytes is a preference; this is not. The ID is a single path component,
# which every filesystem this runs on caps at 255 bytes, so a longer new name
# resolves here and then fails in the bootstrap the contract requires next.
# Existing streams are exempt — one already on disk has proved it fits.
usable_as_path_component() {
  [[ ${#1} -le 255 ]]
}

canonical_directory() {
  (cd "$1" && pwd -P)
}

require_safe_directory_component() {
  local target="$1"
  [[ ! -L "$target" ]] || invalid "state directory must not be a symlink: $target"
  if [[ -e "$target" && ! -d "$target" ]]; then
    invalid "state path component is not a directory: $target"
  fi
}

require_safe_entrypoint() {
  local target="$1"
  [[ ! -L "$target" ]] || invalid "state entrypoint must not be a symlink: $target"
  if [[ -e "$target" && ! -f "$target" ]]; then
    invalid "state entrypoint is not a regular file: $target"
  fi
}

ensure_safe_directory_component() {
  local target="$1"
  require_safe_directory_component "$target"
  if [[ ! -d "$target" ]]; then
    if ! mkdir -- "$target" 2>/dev/null; then
      # A competing bootstrap may have created it. Accept only the same safe
      # directory shape; never follow or replace what appeared.
      require_safe_directory_component "$target"
      [[ -d "$target" ]] || invalid "could not create state directory: $target"
    fi
  fi
  require_safe_directory_component "$target"
  [[ "$(canonical_directory "$target")" == "$target" ]] ||
    invalid "state directory escaped its canonical workspace path: $target"
}

is_effectively_ignored() {
  local workspace_root="$1"
  local probe="$2"
  local git_dir=""

  if git -C "$workspace_root" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$workspace_root" check-ignore --no-index -q -- "$probe"
    return
  fi

  if command -v jj >/dev/null 2>&1 &&
     git_dir="$(cd "$workspace_root" && jj --ignore-working-copy git root 2>/dev/null)" &&
     [[ -n "$git_dir" ]]; then
    git --git-dir="$git_dir" --work-tree="$workspace_root" \
      check-ignore --no-index -q -- "$probe"
    return
  fi

  return 1
}

work_id=""
work_id_source=""
work_id_argument_set=0
start_path="$PWD"
bootstrap=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --work-id)
      [[ $# -ge 2 ]] || { usage; invalid "--work-id requires a value"; }
      work_id="$2"
      work_id_source="argument"
      work_id_argument_set=1
      shift 2
      ;;
    --work-id=*)
      work_id="${1#--work-id=}"
      work_id_source="argument"
      work_id_argument_set=1
      shift
      ;;
    --path)
      [[ $# -ge 2 ]] || { usage; invalid "--path requires a value"; }
      start_path="$2"
      shift 2
      ;;
    --path=*)
      start_path="${1#--path=}"
      [[ -n "$start_path" ]] || { usage; invalid "--path requires a non-empty value"; }
      shift
      ;;
    --bootstrap)
      bootstrap=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      invalid "unknown argument: $1"
      ;;
  esac
done

if [[ $work_id_argument_set -eq 1 ]]; then
  [[ -n "$work_id" ]] || invalid "--work-id requires a non-empty value"
elif [[ -n "${STATE_WORK_ID:-}" ]]; then
  work_id="$STATE_WORK_ID"
  work_id_source="environment"
fi

if [[ -n "$work_id" ]] && ! valid_work_id "$work_id"; then
  invalid "work ID from $work_id_source must be lowercase kebab-case"
fi
[[ -d "$start_path" ]] || invalid "start path is not a directory: $start_path"

start_path="$(canonical_directory "$start_path")"
vcs=""
repo_root=""
default_workspace=""
active_workspace=""
workspace_label=""
workspace_source=""

if command -v jj >/dev/null 2>&1 &&
   active_workspace="$(cd "$start_path" && jj --ignore-working-copy root 2>/dev/null)"; then
  vcs="jj"
  active_workspace="$(canonical_directory "$active_workspace")"
  repo_root="$active_workspace"
  if default_workspace="$(cd "$start_path" &&
      jj --ignore-working-copy workspace root --name default 2>/dev/null)" &&
     [[ -d "$default_workspace" ]]; then
    default_workspace="$(canonical_directory "$default_workspace")"
  else
    default_workspace=""
  fi

  while IFS= read -r candidate_name; do
    [[ -n "$candidate_name" ]] || continue
    candidate_root="$(cd "$start_path" &&
      jj --ignore-working-copy workspace root --name "$candidate_name" 2>/dev/null || true)"
    if [[ -d "$candidate_root" ]] &&
       [[ "$(canonical_directory "$candidate_root")" == "$active_workspace" ]]; then
      workspace_label="$candidate_name"
      workspace_source="jj_workspace"
      break
    fi
  done < <(cd "$start_path" &&
    jj --ignore-working-copy workspace list -T 'name ++ "\n"' 2>/dev/null || true)
elif active_workspace="$(cd "$start_path" && git rev-parse --show-toplevel 2>/dev/null)"; then
  vcs="git"
  active_workspace="$(canonical_directory "$active_workspace")"
  repo_root="$active_workspace"
  default_workspace="$(cd "$start_path" && git worktree list --porcelain | \
    awk 'NR == 1 && $1 == "worktree" {sub(/^worktree /, ""); print; exit}')"
  if [[ -n "$default_workspace" && -d "$default_workspace" ]]; then
    default_workspace="$(canonical_directory "$default_workspace")"
  else
    default_workspace=""
  fi
  workspace_label="$(cd "$start_path" &&
    git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ -n "$workspace_label" ]]; then
    workspace_source="git_branch"
  fi
else
  invalid "path is not inside a Git worktree or jj workspace: $start_path"
fi

# Work state is centralized: it lives only in the default source tree, so a
# secondary worktree or workspace reads and writes the same .state/.
# Falling back to the active tree keeps single-tree and detached checkouts
# working when no default tree can be discovered.
state_root="${default_workspace:-$active_workspace}"

state_dir="$state_root/.state"
work_root="$state_dir/works"
archive_root="$state_dir/archive"
# A parked stream still owns its name. Minting a second one beside it would
# leave two streams with one identity and no way to tell which unparks.
if [[ -n "$work_id" && ! -d "$work_root/$work_id" && -d "$archive_root/$work_id" ]]; then
  invalid "work ID from $work_id_source names a parked stream under archive/; unpark that one instead of minting a second"
fi

# The canonical shape governs minting, never resumption: a stream created
# before these rules keeps its name, and the workflows that resume it forward
# that exact ID back.
if [[ -n "$work_id" && ! -d "$work_root/$work_id" ]] &&
   ! canonical_work_id "$work_id"; then
  invalid "a new work ID from $work_id_source must be single-hyphen kebab-case"
fi
if [[ -n "$work_id" && ! -d "$work_root/$work_id" ]] &&
   ! usable_as_path_component "$work_id"; then
  invalid "a new work ID from $work_id_source must fit a path component, at most 255 bytes"
fi

require_safe_directory_component "$state_dir"
require_safe_directory_component "$work_root"
if [[ -d "$state_dir" ]] &&
   [[ "$(canonical_directory "$state_dir")" != "$state_dir" ]]; then
  invalid "state directory escaped its canonical workspace path: $state_dir"
fi
if [[ -d "$work_root" ]] &&
   [[ "$(canonical_directory "$work_root")" != "$work_root" ]]; then
  invalid "state root escaped its canonical workspace path: $work_root"
fi

work_candidates=()
candidate_dir=""
while IFS= read -r candidate_dir; do
  [[ -n "$candidate_dir" ]] || continue
  candidate_id="${candidate_dir##*/}"
  if valid_work_id "$candidate_id"; then
    work_candidates+=("$candidate_id")
  fi
done < <(find "$work_root" -mindepth 1 -maxdepth 1 \
  -type d 2>/dev/null | LC_ALL=C sort)

# Which names are spoken for is a different question from which streams are
# live: an archived ID resolves nothing, but minting over it gives one identity
# two streams. Keeping the two lists apart is load-bearing — folding archive/
# into work_candidates makes a parked stream resolve as a live one.
taken_ids=()
while IFS= read -r candidate_dir; do
  [[ -n "$candidate_dir" ]] || continue
  candidate_id="${candidate_dir##*/}"
  if valid_work_id "$candidate_id"; then
    taken_ids+=("$candidate_id")
  fi
done < <(find "$work_root" "$archive_root" -mindepth 1 -maxdepth 1 \
  -type d 2>/dev/null | LC_ALL=C sort)

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

is_work_candidate() {
  local wanted="$1" candidate_id
  [[ -n "$wanted" ]] || return 1
  for candidate_id in ${work_candidates[@]+"${work_candidates[@]}"}; do
    if [[ "$candidate_id" == "$wanted" ]]; then
      return 0
    fi
  done
  return 1
}

workspace_work_id=""
workspace_match_id=""
workspace_is_meaningful=0
if [[ -n "$workspace_label" ]]; then
  # Whether the label says anything about which stream is in play is a
  # separate question from whether it yields a usable suggestion: a label
  # this parser cannot read is still not a generic trunk, so it must not
  # re-open the sole-existing fallback below.
  # Normalization only recognizes the generic trunk names; a label that folds
  # to nothing (`影師嗎`) is still a label the caller chose, so it must not
  # read as absent and re-open the sole-existing fallback.
  label_slug="$(slugify "$workspace_label")"
  if [[ ! "$label_slug" =~ ^(default|main|master|trunk)$ ]]; then
    workspace_is_meaningful=1
  fi

  # Only two label shapes carry a work ID, and both put it in a whole segment:
  # a jj workspace named for the stream, and the branch `<type>/<work-id>`
  # with an optional two-digit stack slice under it. Reading anything looser —
  # a trailing segment that merely happens to match, a longer ordinal, a
  # leading word that is not a conventional-commit type — opens the wrong
  # `.state/works/<id>/`, which is worse than asking.
  IFS='/' read -r -a label_segments <<<"$workspace_label"
  candidate_from_label=""
  case "${#label_segments[@]}" in
    1)
      # a jj workspace is named for the stream it works; a one-segment Git
      # branch is not a documented branch shape and so names nothing
      if [[ "$workspace_source" == "jj_workspace" ]] &&
         [[ ! "${label_segments[0]}" =~ ^(default|main|master|trunk)$ ]]; then
        candidate_from_label="${label_segments[0]}"
      fi
      ;;
    2 | 3)
      if [[ "${label_segments[0]}" =~ ^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)$ ]] &&
         { [[ "${#label_segments[@]}" -eq 2 ]] ||
           [[ "${label_segments[2]}" =~ ^(0[1-9]|[1-9][0-9])-[a-z0-9]+(-[a-z0-9]+)*$ ]]; }; then
        candidate_from_label="${label_segments[1]}"
      fi
      ;;
  esac

  if [[ -n "$candidate_from_label" ]]; then
    # Matching an existing stream and proposing a new one are separate
    # questions. Match on the segment as written — never on its slug, since
    # `feat/foo_bar` is not the branch of a `foo-bar` stream — and put no
    # minting rule in the way, so a stream named under older rules still
    # resolves from its own branch.
    if valid_work_id "$candidate_from_label" &&
       is_work_candidate "$candidate_from_label"; then
      workspace_match_id="$candidate_from_label"
    fi
    # A suggestion is a new identity, so it must be one this contract would
    # actually mint; recommending anything else sends the PM to a bootstrap
    # that then refuses it.
    if canonical_work_id "$candidate_from_label" &&
       within_id_bound "$candidate_from_label" &&
       [[ ! -d "$archive_root/$candidate_from_label" ]]; then
      workspace_work_id="$candidate_from_label"
    fi
  fi
fi

if [[ -z "$work_id" ]]; then
  if [[ -n "$workspace_match_id" ]]; then
    work_id="$workspace_match_id"
    work_id_source="$workspace_source"
  elif [[ ${#work_candidates[@]} -eq 1 && $workspace_is_meaningful -eq 0 ]]; then
    work_id="${work_candidates[0]}"
    work_id_source="sole_existing"
  else
    # The list is every name on disk, live in works/ or parked in archive/, so
    # a proposed name can be checked against it for a collision. It is never a set of format examples: names
    # minted under older rules keep resolving forever, so reading the shape off
    # them reproduces exactly the drift this response is asked to stop. The
    # grammar and the file that owns it ship in the same body, so the reader
    # never has to infer either.
    existing_work_ids_json="$(jq -n '$ARGS.positional | unique' \
      --args ${taken_ids[@]+"${taken_ids[@]}"})"
    naming_reference="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/references/naming.md"
    jq -n \
      --arg vcs "$vcs" \
      --arg repo_root "$repo_root" \
      --arg active_workspace "$active_workspace" \
      --arg default_workspace "$default_workspace" \
      --arg workspace_label "$workspace_label" \
      --arg state_root "$state_root" \
      --arg suggested_work_id "$workspace_work_id" \
      --arg work_id_grammar '^[a-z0-9]+(-[a-z0-9]+)*$ at or under 32 bytes, naming what the work is about: no date prefix, no type prefix, no random suffix' \
      --arg naming_reference "$naming_reference" \
      --argjson existing_work_ids "$existing_work_ids_json" \
      --arg error "work ID cannot be selected safely; the PM must ask the user. existing_work_ids are every stream on disk under works/ and archive/, to check a proposed ID against for collision — not examples of the format, which is work_id_grammar" \
      '{status:"work_id_required", vcs:$vcs, repo_root:$repo_root,
        durable_root:$active_workspace, active_workspace:$active_workspace,
        state_root:$state_root,
        default_workspace:(if $default_workspace == "" then null else $default_workspace end),
        workspace_label:(if $workspace_label == "" then null else $workspace_label end),
        suggested_work_id:(if $suggested_work_id == "" then null
          else $suggested_work_id end),
        work_id_grammar:$work_id_grammar, naming_reference:$naming_reference,
        existing_work_ids:$existing_work_ids, error:$error}'
    exit 4
  fi
fi

work_dir="$work_root/$work_id"
ignore_file="$state_root/.gitignore"
active_probe=".state/works/$work_id/state.md"

require_safe_directory_component "$work_dir"
if [[ -d "$work_dir" ]] &&
   [[ "$(canonical_directory "$work_dir")" != "$work_dir" ]]; then
  invalid "state directory escaped its canonical workspace path: $work_dir"
fi
require_safe_directory_component "$work_dir/state"
require_safe_entrypoint "$work_dir/state/working.md"
require_safe_entrypoint "$work_dir/state.md"
require_safe_entrypoint "$work_dir/goal.md"
require_safe_entrypoint "$work_dir/state/journal.md"

if [[ ! -f "$ignore_file" ]] ||
   ! grep -Eq '^[[:space:]]*\.state/[[:space:]]*(#.*)?$' "$ignore_file" ||
   ! is_effectively_ignored "$state_root" "$active_probe"; then
  jq -n \
    --arg vcs "$vcs" \
    --arg repo_root "$repo_root" \
    --arg durable_root "$active_workspace" \
    --arg default_workspace "$default_workspace" \
    --arg active_workspace "$active_workspace" \
    --arg state_root "$state_root" \
    --arg workspace_label "$workspace_label" \
    --arg work_id "$work_id" \
    --arg work_id_source "$work_id_source" \
    --arg work_dir "$work_dir" \
    --arg ignore_file "$ignore_file" \
    --arg error "PM must add .state/ to the default source tree .gitignore before creating work artifacts" \
    '{status:"requires_ignore", vcs:$vcs, repo_root:$repo_root,
      durable_root:$durable_root,
      default_workspace:(if $default_workspace == "" then null else $default_workspace end),
      active_workspace:$active_workspace, state_root:$state_root,
      workspace_label:(if $workspace_label == "" then null else $workspace_label end),
      work_id:$work_id, work_id_source:$work_id_source, work_dir:$work_dir,
      ignore_file:$ignore_file, error:$error}'
  exit 3
fi

bootstrap_created=()
bootstrap_existing=()
write_bootstrap_file() {
  local target="$1"
  local contents="$2"

  require_safe_entrypoint "$target"
  if [[ -e "$target" ]]; then
    bootstrap_existing+=("$target")
    return
  fi

  if (set -o noclobber; printf '%s' "$contents" >"$target") 2>/dev/null; then
    bootstrap_created+=("$target")
  elif [[ -L "$target" ]]; then
    invalid "state entrypoint became a symlink during bootstrap: $target"
  elif [[ -e "$target" && ! -f "$target" ]]; then
    invalid "state entrypoint became non-regular during bootstrap: $target"
  elif [[ -f "$target" ]]; then
    # Another PM bootstrap won the create race. Preserve its file verbatim.
    bootstrap_existing+=("$target")
  else
    invalid "could not create bootstrap file: $target"
  fi
}

if [[ $bootstrap -eq 1 ]]; then
  ensure_safe_directory_component "$state_dir"
  ensure_safe_directory_component "$work_root"
  ensure_safe_directory_component "$work_dir"
  ensure_safe_directory_component "$work_dir/state"
  bootstrap_timestamp="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  # Provenance stamp: short hash of the contract this bootstrap follows.
  # Provenance only, never authority — the current contracts always judge.
  contract_reference="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/references/state.md"
  if command -v sha256sum >/dev/null 2>&1; then
    written_under="$(sha256sum "$contract_reference" | cut -c1-8)"
  else
    written_under="$(shasum -a 256 "$contract_reference" | cut -c1-8)"
  fi
  working_contents="# Current focus

- Work ID: \`$work_id\`
- Updated: \`$bootstrap_timestamp\`
- Status: Bootstrapped; the charter is not written yet.
- Working now: Confirm the goal, scope, and acceptance criteria.
- Handback point: First-use bootstrap is complete; discovery has not started.

## Fast paths

- Charter: [goal.md](../goal.md)
- Specification: [goal.md#specification-provenance](../goal.md#specification-provenance)
- State: [state.md](../state.md)
"
  state_contents="# Work state

- State role: \`root\`
- Work ID: \`$work_id\`
- Phase: \`planned\`
- Updated: \`$bootstrap_timestamp\`
- Charter: [goal.md](goal.md)
- Current focus: [working.md](state/working.md)
- Journal: [journal.md](state/journal.md)
- Plan source: \`state.md\`
- Plan revision: \`1\`
- State revision: \`1\`
- Written under: \`$written_under\`
- Next owner: \`PM\`
- Next action: Confirm the charter in goal.md with the user.
- Repository revision: Not captured yet.
- Sync state: Not started.
- Review state: Not started.

## Status

- Topology: \`linear\`
- Overall graph: \`GOL → OWN\`

## Tasks

| ID | Mark | Status | Task | Depends on | Required | Acceptance | Owner | Evidence / next action |
| --- | --- | --- | --- | --- | --- | --- | --- | --- |
| GOL | - | planned | Confirm the charter: goal, scope, and success criteria. [targets: goal.md] | — | yes | goal.md records the goal, scope, and measurable success criteria. | PM | Confirm with the user. |
| OWN | - | planned | Select the next owning skill. [targets: none] | GOL | yes | The next owning skill and handback point are recorded. | PM | Wait for GOL. |

## Decisions

None recorded.

## Dependencies, blockers, and risks

None known.

## Evidence and validation

None recorded.
"
  goal_contents="# Charter

- Work ID: \`$work_id\`
- Charter: \`absent\`
- Charter revision: \`1\`
- Created: \`$bootstrap_timestamp\`
- State: [state.md](state.md)

## Goal

Pending confirmation with the user.

## Scope and non-goals

Pending confirmation with the user.

## Success criteria

| ID | Criterion | Acceptance evidence |
| --- | --- | --- |
| SC-1 | Pending confirmation with the user. | Pending. |

## Specification provenance

- Source kind: \`pending\`
- Canonical specification: Pending user confirmation
- Accepted revision/base: Pending user confirmation
- Local materialization: Pending user confirmation
- Materialization receipt: Pending user confirmation
- Last verification status: \`pending\`
- Last verified at: Pending user confirmation

## Workspace anchors

- kind: \`$vcs\` · locator: \`$active_workspace\` · revision semantics: commit/change id
"
  journal_contents="# Journal

Append-only event log, newest last, never rewritten. Line grammar:
\`- <ISO-8601> <actor>@<capability_id> rev:<N> <event-type> <subject>: <summary> [evidence: <ref>] [invalidates: <ids>]\`
with event types \`status|decision|revision|sync|sweep|lease\`.

- $bootstrap_timestamp PM@pm rev:1 status $work_id: bootstrapped, phase \`planned\`
"
  write_bootstrap_file "$work_dir/goal.md" "$goal_contents"
  write_bootstrap_file "$work_dir/state/working.md" "$working_contents"
  write_bootstrap_file "$work_dir/state.md" "$state_contents"
  write_bootstrap_file "$work_dir/state/journal.md" "$journal_contents"
  require_safe_entrypoint "$work_dir/goal.md"
  require_safe_entrypoint "$work_dir/state/working.md"
  require_safe_entrypoint "$work_dir/state.md"
  require_safe_entrypoint "$work_dir/state/journal.md"
fi

created_json="$(jq -n '$ARGS.positional' \
  --args ${bootstrap_created[@]+"${bootstrap_created[@]}"})"
existing_json="$(jq -n '$ARGS.positional' \
  --args ${bootstrap_existing[@]+"${bootstrap_existing[@]}"})"

jq -n \
  --arg vcs "$vcs" \
  --arg repo_root "$repo_root" \
  --arg durable_root "$active_workspace" \
  --arg default_workspace "$default_workspace" \
  --arg active_workspace "$active_workspace" \
  --arg state_root "$state_root" \
  --arg workspace_label "$workspace_label" \
  --arg work_id "$work_id" \
  --arg work_id_source "$work_id_source" \
  --arg work_dir "$work_dir" \
  --arg ignore_file "$ignore_file" \
  --argjson bootstrap_requested "$bootstrap" \
  --argjson bootstrap_created "$created_json" \
  --argjson bootstrap_existing "$existing_json" \
  '{status:"resolved", vcs:$vcs, repo_root:$repo_root,
    durable_root:$durable_root,
    default_workspace:(if $default_workspace == "" then null else $default_workspace end),
    active_workspace:$active_workspace, state_root:$state_root,
    workspace_label:(if $workspace_label == "" then null else $workspace_label end),
    work_id:$work_id, work_id_source:$work_id_source, work_dir:$work_dir,
    ignore_file:$ignore_file, state_ignored:true,
    bootstrap_requested:($bootstrap_requested == 1),
    bootstrap_created:$bootstrap_created,
    bootstrap_existing:$bootstrap_existing}'
