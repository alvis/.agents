#!/usr/bin/env bash
set -euo pipefail

# PreToolUse gate for AskUserQuestion: enforces the tag format documented in
# directions/questions.md. Format only — no judgement of wording.
# Compatible with bash 3.2+

SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=/dev/null
source "$SCRIPTS_DIR/context.sh"
deny() {
  output_pretooluse_decision "deny" "$1 Read essential:directions/questions.md before correcting the question."
}

allow() {
  output_pretooluse_decision "allow" \
    "Remind you to follow instructions in essential:directions/questions.md"
}

input=$(cat)

# Reject unsupported envelopes before accessing their fields.
if ! jq -se 'length == 1 and (.[0] | type == "object")' <<<"$input" >/dev/null 2>&1; then
  deny "Question validation is unavailable: expected a JSON object."
fi
tool_name="$(jq -r '.tool_name // .toolName // empty' <<<"$input")"
if ! input="$(jq -ce --arg tool "$tool_name" '
  def require(condition): if condition then . else error("unsupported question schema") end;
  (.tool_input // .toolInput)
  | require(type == "object")
  | .questions |= (require(type == "array" and length > 0) | map(
      if ($tool | endswith("request_user_input_async")) then
        require(.title | type == "string" and length > 0)
        | if has("options") then
            .options |= (require(type == "array" and length > 0)
              | map(require(type == "string" and length > 0) | {label: ., description: ""}))
          else .options = [] end
      else
        require(.question | type == "string" and length > 0)
        | .options |= (require(type == "array" and length > 0) | map(
            require(type == "object")
            | require(.label | type == "string" and length > 0)
            | require((has("description") | not) or (.description | type == "string"))))
      end))
' <<<"$input" 2>/dev/null)"; then
  deny "Question validation is unavailable: unsupported question payload. Supply nonempty questions and correctly typed options."
fi

# A tag is a single capitalised word in brackets, so ordinary Markdown links in
# a description are not mistaken for one. Only the first line of a description
# counts, matching where questions.md says tags may go. An option that already
# carries a valid tag is not searched for unknown ones, so bracketed prose such
# as "[Note]" beside a real tag is not read as a tag claim.
reason=$(printf '%s' "$input" | jq -r '
  ["Architectural","Ideal","Recommended","Pragmatic","Hotfix","Workaround"] as $valid
  | [ .questions[]?
      | [ .options[]?
          | { label: (.label // ""),
              tags: ( ( (.label // "") + " " + (((.description // "") | split("\n"))[0] // "") )
                      | [ scan("\\[[A-Z][A-Za-z]*\\]") | .[1:-1] ] ) } ] as $opts
      | [ $opts[]
          | . as $opt
          | { label: $opt.label,
              good: [ $opt.tags[] | select(. as $t | ($valid | index($t)) != null) ],
              unknown: [ $opt.tags[] | select(. as $t | ($valid | index($t)) == null) ] } ] as $scored
      | ( [ $scored[] | select((.good | length) == 0) ] ) as $tagless
      | if ($tagless | length) > 0
        then ( $tagless[0] ) as $first
          | if ($first.unknown | length) > 0
            then "unknown tag [" + ($first.unknown | join("], [")) + "] on option \"" + $first.label + "\". Use only: " + ($valid | join(", ")) + "."
            else "option \"" + $first.label + "\" carries no tag. Tag every option with one or more of: " + ($valid | join(", ")) + "."
            end
        else empty
        end ]
  | .[0] // ""
')

if [[ -n "$reason" ]]; then
  deny "$reason"
fi

allow
