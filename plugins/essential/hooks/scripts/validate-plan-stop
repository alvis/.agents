#!/usr/bin/env bash
set -euo pipefail

# Codex Plan Mode in T3 emits a plan response without calling a plan tool.
# Validate the current final response at Stop, independently of approval policy.
# Compatible with bash 3.2+

SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=/dev/null
source "$SCRIPTS_DIR/context.sh"

stop_with_feedback() {
  local reason="$1"
  local active="$2"
  local retry_flag="$3"
  if [[ "$active" == "true" && -e "$retry_flag" ]]; then
    reason="Plan validation still failed after one corrective continuation. ${reason}"
    jq -cn --arg reason "$reason" \
      '{continue: false, stopReason: $reason, systemMessage: $reason}'
  else
    jq -cn --arg reason "$reason" '{decision: "block", reason: $reason}'
    : >"$retry_flag"
  fi
  exit 0
}

input="$(cat)"
if ! printf '%s' "$input" | jq -e . >/dev/null 2>&1; then
  exit 0
fi

harness="$(resolve_harness)" || {
  echo "plugin root unset" >&2
  exit 1
}
if [[ "$harness" != "codex" ]]; then
  exit 0
fi

active="$(jq -r '(.stop_hook_active // .stopHookActive // false) == true' <<<"$input")"
session_id="$(jq -r '(.session_id // .sessionId) | select(type == "string") // empty' <<<"$input")"
turn_id="$(jq -r '(.turn_id // .turnId) | select(type == "string") // empty' <<<"$input")"
transcript_path="$(jq -r '(.transcript_path // .transcriptPath) | select(type == "string") // empty' <<<"$input")"
unavailable_reason="Plan validation is unavailable for this turn: the current assistant response could not be read."
if ! retry_digest="$(printf '%s\0%s' "$session_id" "$turn_id" | git hash-object --stdin 2>/dev/null)"; then
  exit 1
fi
retry_flag="${TMPDIR:-/tmp}/essential-plan-stop-${retry_digest}"

# the event text is current even when the asynchronous transcript has not flushed
if jq -e '.last_assistant_message | type == "string"' <<<"$input" >/dev/null; then
  message="$(jq -r '.last_assistant_message' <<<"$input")"
else
  if [[ -z "$turn_id" || -z "$transcript_path" || ! -f "$transcript_path" || ! -r "$transcript_path" ]] ||
     [[ ! -s "$transcript_path" ]] ||
     ! jq -R 'select(length > 0) | fromjson' "$transcript_path" >/dev/null 2>&1; then
    jq -cn --arg reason "$unavailable_reason" '{systemMessage: $reason}'
    exit 0
  fi
  encoded_message="$(jq -Rr --arg turn_id "$turn_id" '
    fromjson?
    | select(.type == "response_item")
    | .payload
    | select(.type == "message" and .role == "assistant" and .phase == "final_answer")
    | select(.internal_chat_message_metadata_passthrough.turn_id == $turn_id)
    | [.content[]? | select(.type == "output_text") | .text]
    | map(select(type == "string"))
    | join("")
    | @base64
  ' "$transcript_path" | tail -n 1)"
  if [[ -z "$encoded_message" ]]; then
    jq -cn --arg reason "$unavailable_reason" '{systemMessage: $reason}'
    exit 0
  fi
  message="$(printf '%s' "$encoded_message" | jq -Rr '@base64d')"
fi

# delimiters inside examples are prose, not a plan presentation
candidate="$(jq -Rsc '
  split("\n") as $lines
  | reduce range(0; $lines | length) as $index
    ({fence: "", opening: [], closing: []};
      ($lines[$index] | sub("\r$"; "")) as $line
      | if .fence != "" then
          .fence as $fence
          | if ($line | test("^ {0,3}" + $fence[0:1] + "{" + ($fence | length | tostring) + ",}[ \t]*$"))
            then .fence = "" else . end
        elif ($line | test("^ {0,3}(`{3,}|~{3,})")) then
          .fence = ($line | capture("^ {0,3}(?<marker>`{3,}|~{3,})").marker)
        elif ($line | test("^ {0,3}<proposed_plan>[ \t]*$")) then
          .opening += [$index]
        elif ($line | test("^ {0,3}</proposed_plan>[ \t]*$")) then
          .closing += [$index]
        else . end)
  | . + {lines: $lines}
' <<<"$message")"
opening_count="$(jq '.opening | length' <<<"$candidate")"
closing_count="$(jq '.closing | length' <<<"$candidate")"
if [[ "$opening_count" == "0" && "$closing_count" == "0" ]]; then
  exit 0
fi

envelope_reason="T3/Codex Plan Mode must emit exactly one complete <proposed_plan> block. Re-emit the corrected plan without an additional plan block."
if [[ "$opening_count" != "1" || "$closing_count" != "1" ]] ||
   ! jq -e '.opening[0] < .closing[0]' <<<"$candidate" >/dev/null; then
  stop_with_feedback "$envelope_reason" "$active" "$retry_flag"
fi

plan="$(jq -r '.lines[.opening[0] + 1:.closing[0]] | join("\n")' <<<"$candidate")"
validator_input="$(jq -cn --arg plan "$plan" '{tool_input: {plan: $plan}}')"
if ! validator_output="$(printf '%s' "$validator_input" | "$SCRIPTS_DIR/validate-plan")" ||
   ! printf '%s' "$validator_output" | jq -e . >/dev/null 2>&1; then
  stop_with_feedback "$unavailable_reason" "$active" "$retry_flag"
fi

decision="$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$validator_output")"
if [[ "$decision" != "deny" ]]; then
  exit 0
fi

reason="$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"$validator_output")"
if [[ -z "$reason" ]]; then
  stop_with_feedback "$unavailable_reason" "$active" "$retry_flag"
fi
stop_with_feedback "${reason} Re-emit one corrected <proposed_plan> block." "$active" "$retry_flag"
