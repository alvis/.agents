#!/usr/bin/env bash
set -euo pipefail

# PreToolUse gate for plan headings and Git-backed working branch names.
# Compatible with bash 3.2+

SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=/dev/null
source "$SCRIPTS_DIR/context.sh"
# shellcheck source=/dev/null
source "$SCRIPTS_DIR/../../scripts/branch-naming.sh"
deny() {
  output_pretooluse_decision "deny" "$1 Read essential:directions/plan.md before correcting the plan."
}

allow() {
  output_pretooluse_decision "allow" \
    "Remind you to follow instructions in essential:directions/plan.md"
}

input=$(cat)

if ! printf '%s' "$input" | jq -se 'length == 1 and (.[0] | type == "object")' >/dev/null 2>&1; then
  deny "Plan validation is unavailable: expected a JSON object."
fi

harness="$(resolve_harness)" || {
  echo "plugin root unset" >&2
  exit 1
}
tool_name="$(jq -r '.tool_name // .toolName // empty' <<<"$input")"
tool_input="$(jq -c '.tool_input // .toolInput // {}' <<<"$input")"
if ! jq -e 'type == "object"' <<<"$tool_input" >/dev/null; then
  deny "Plan validation is unavailable: tool input must be an object."
fi
plan_path=""

# Grok reads the session plan rather than accepting model-supplied plan prose.
# Its transcript is session_dir/updates.jsonl; both paths share one session root.
if [[ "$harness" == "grok" && "$tool_name" == "exit_plan_mode" ]]; then
  transcript_path="$(jq -r '(.transcript_path // .transcriptPath) | select(type == "string") // empty' <<<"$input")"
  if [[ "$transcript_path" != /* || ! -f "$transcript_path" || ! -r "$transcript_path" ]]; then
    deny "Plan validation is unavailable: the current Grok session transcript is missing. Restore session access before presenting the plan."
  fi
  plan_path="$(dirname "$transcript_path")/plan.md"
elif [[ "$(jq -r '.plan | type' <<<"$tool_input")" == "string" ]]; then
  plan="$(jq -r '.plan' <<<"$tool_input")"
elif [[ "$tool_name" == "ExitPlanMode" ]]; then
  plan_path="$(jq -r '.planFilePath | select(type == "string") // empty' <<<"$tool_input")"
  if [[ "$plan_path" != /* ]]; then
    deny "Plan validation is unavailable: ExitPlanMode did not provide plan content or an absolute planFilePath. Restore the current plan before presenting it."
  fi
elif [[ "$tool_name" == "exit_plan_mode" || "$tool_name" == "plan_exit" ]]; then
  deny "Plan validation is unavailable: the plan-exit event did not provide the current plan."
else
  # progress step arrays and entering plan mode do not present plan prose
  allow
fi

if [[ -n "$plan_path" ]]; then
  if [[ ! -f "$plan_path" || ! -r "$plan_path" ]] || ! plan="$(cat "$plan_path")"; then
    deny "Plan validation is unavailable: the current session plan cannot be read. Restore it before presenting the plan."
  fi
fi

missing=""
for heading in Goal Requirements Boundary "Out of Scope" "Working environment" Tasks Direction Context; do
  if ! printf '%s\n' "$plan" | grep -Ei "^#{1,6}[[:space:]]*([^[:alnum:][:space:]#]+[[:space:]]+)?${heading}\\b" >/dev/null; then
    if [[ -n "$missing" ]]; then
      missing="${missing}, ${heading}"
    else
      missing="$heading"
    fi
  fi
done

if [[ -n "$missing" ]]; then
  deny "missing headings: ${missing}."
fi

working_directory="$(jq -r '.cwd | select(type == "string" and length > 0) // empty' <<<"$input")"
working_directory="${working_directory:-$PWD}"
if [[ ! -d "$working_directory" ]]; then
  deny "Plan validation is unavailable: the working directory cannot be read."
fi

if git -C "$working_directory" rev-parse --git-dir >/dev/null 2>&1 ||
   (cd "$working_directory" && command -v jj >/dev/null 2>&1 &&
    jj --ignore-working-copy git root >/dev/null 2>&1); then
  working_environment="$(printf '%s\n' "$plan" | awk '
    /^#+[[:space:]]/ {
      match($0, /^#+/)
      level = RLENGTH
      if (level <= 6) {
        title = tolower(substr($0, level + 1))
        sub(/^[[:space:]]*([^[:alnum:][:space:]#]+[[:space:]]+)?/, "", title)
        if (title ~ /^working environment([^[:alnum:]_]|$)/) {
          in_environment = 1
          depth = level
        } else if (level <= depth) {
          in_environment = 0
        }
        next
      }
    }
    in_environment { print }
  ')"
  branch_names="$(printf '%s' "$working_environment" | jq -Rsc '
    def entry: "^[[:space:]]*([-*+][[:space:]]+)?(\\*\\*)?(Branch|Bookmark)(\\*\\*)?:[[:space:]]*(\\*\\*)?[[:space:]]*";
    split("\n")
    | map(select(test(entry; "i")) | sub(entry; ""; "i")
      | if startswith("`") then
          . as $value | ([capture("^`(?<name>[^`]*)`").name][0] // $value)
        else capture("^(?<name>[^[:space:]]*)").name end)
  ')"
  if [[ "$(jq 'length' <<<"$branch_names")" == "0" ]]; then
    deny "Git-backed plans require a proposed Branch: <name> or Bookmark: <name> entry in Working environment. Follow essential:references/naming.md#branch."
  fi
  while IFS= read -r branch_name; do
    if [[ ! "$branch_name" =~ $canonical_branch_pattern ]]; then
      deny "Invalid proposed branch or bookmark '$branch_name'. Follow essential:references/naming.md#branch."
    fi
  done < <(jq -r '.[]' <<<"$branch_names")
fi

allow
