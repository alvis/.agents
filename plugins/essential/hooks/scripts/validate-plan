#!/usr/bin/env bash
set -euo pipefail

# PreToolUse gate for ExitPlanMode: enforces the required headings documented in
# directions/plan.md. Presence only — order and content are not
# judged. Compatible with bash 3.2+

SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=/dev/null
source "$SCRIPTS_DIR/context.sh"

deny() {
  output_pretooluse_decision "deny" "$1"
}

allow() {
  output_pretooluse_decision "allow" \
    "Remind you to follow instructions in essential:directions/plan.md"
}

input=$(cat)

if ! printf '%s' "$input" | jq -e . >/dev/null 2>&1; then
  allow
fi

# Claude Code and Codex send snake_case tool_input; Grok Build sends camelCase
# toolInput. Collapse once so every field read below is key-agnostic.
input=$(printf '%s' "$input" | jq -c '(.tool_input // .toolInput)')

# The plan body travels inline in tool_input.plan. Codex's update_plan carries a
# step array under the same key and has no headings to check, so anything that
# is not plan prose passes straight through. Known no-op under Grok Build: its
# exit_plan_mode reads plan.md from the session directory on disk and sends no
# plan field, so this gate fail-opens there by design.
if [[ "$(printf '%s' "$input" | jq -r '.plan | type')" != "string" ]]; then
  allow
fi

plan=$(printf '%s' "$input" | jq -r '.plan')

missing=""
for heading in Goal Requirements Boundary Direction Context; do
  if ! printf '%s\n' "$plan" | grep -Eqi "^#{1,6}[[:space:]]*${heading}\\b"; then
    if [[ -n "$missing" ]]; then
      missing="${missing}, ${heading}"
    else
      missing="$heading"
    fi
  fi
done

if [[ -n "$missing" ]]; then
  deny "missing headings: ${missing}. See essential:directions/plan.md."
fi

allow
