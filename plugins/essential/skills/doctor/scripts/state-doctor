STATE_EVIDENCE_LINE = re.compile(
    r"\b(?:merged?|completed|reviewing|landed|shipped|pull request|PR)\b",
    re.IGNORECASE,
)
# A fallback to state.md is honest only while it says so.
STATE_FALLBACK_MARK = "(from state.md)"
COMPLETION_RECEIPT_HEADING = re.compile(
