    r"\[[^\]]*\]\(\s*((?:<[^<>\s]+>)|(?:[^\s<>)]+))"
    r"(?:\s+(?:\"[^\"]*\"|'[^']*'|\([^)]*\)))?\s*\)"
)
ADR_REFERENCE_LINK = re.compile(
    r"(?<!!)\[([^\]]+)\]\[([^\]]*)\]"
)
ADR_REFERENCE_SHORTCUT = re.compile(
    r"(?<![!\]])\[([^\]]+)\](?!\s*(?:\(|\[|:))"
)
ADR_REFERENCE_DEFINITION = re.compile(
    r"^[ \t]{0,3}\[([^\]]+)\]:\s*(?:<([^>\n]+)>|([^\s]+))"
