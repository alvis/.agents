#!/usr/bin/env python3
"""Structural doctor for Essential local state and ADRs.

A doctor, not a judge: this tool reports deterministic structural defects that
machines detect better than readers — broken IDs, dangling dependencies,
cycles, contradictory mark/status pairs, missing evidence annotations, broken
file references, unsuperseded decisions, stale leases, overview drift, and ADR
supersession/index/integrity violations, including project and stream
specification provenance. It never silently edits files and
never blocks by default; free-form Markdown it cannot parse is at most an
`info` finding. ADR findings include a proposed repair for the doctor skill to
offer for explicit user approval. `--strict` exits nonzero when error-severity
findings exist, for use when work is irreversible or release-critical.
"""

from __future__ import annotations

import argparse
import hashlib
from html import unescape
import json
import re
import sys
import time
from pathlib import Path
from urllib.parse import unquote, urlsplit

MARK_STATUS = {
    "-": "planned",
    "⧗": "working",
    "✓": "done",
    "X": "failed",
    "!": "blocked",
    "⊘": "cancelled",
}
LIFECYCLE_STATUSES = (
    "initialized",
    "active",
    "blocked",
    "reviewing",
    "completed",
    "retiring",
)
# Phase says where a stream sits in the pipeline; `Blocked on` names what
# stopped it, and is absent when nothing has. One field carried both until a
# stream blocked on an operator either lied as `active` or lost its pipeline
# place as `blocked`.
PHASES = ("planned", "working", "reviewing", "completed", "archived")
RETIRED_LIFECYCLE_WORDS = {
    "initialized": "phase `planned`",
    "active": "phase `working`",
    "blocked": "`Blocked on: <who or what>`",
    "retiring": "phase `completed` + `Blocked on: retention`",
}
# `Blocked on` is nullable and one key per line: a named blocker, `unknown`
# when nobody recorded why, and absent when nothing blocks the stream. Absence
# and `unknown` are different facts, so `unknown` is never an unowned value.
BLOCKED_ON_UNKNOWN = "unknown"
BLOCKED_ON_LINE = re.compile(r"^-\s*Blocked on\s*:", re.MULTILINE)
# Keyed on the raw line, not the parsed value: a packed line parses as nothing
# and would otherwise be offered no migration at all. `Motion` is matched
# anywhere on a metadata line rather than only as its first key, because
# `- Phase: `x` · Motion: `y`` is the shape most in need of the offer and the
# one an anchored `^-\s*Motion` misses.
MOTION_LINE = re.compile(r"^-.*\bMotion\s*:", re.MULTILINE)
RETIRED_MOTION_VALUE = re.compile(
    r"^(?:running|idle\s+\d+d|waiting\b.*)$", re.IGNORECASE
)
MOTION_MIGRATION = (
    "`running` → drop the field entirely (nothing is blocking the stream); "
    "`idle <N>d` → `Blocked on: unknown`, since no reason was ever recorded "
    "and inventing one would be false; `waiting: X` → `Blocked on: X`; "
    "`waiting:` with no blocker → `Blocked on: unknown`; anything else → "
    "rewrite by hand as the named blocker or `unknown`"
)
# A blocker nobody wrote down is honest on the day it is recorded and useless
# a week later: past a full working week nobody but the author can still
# reconstruct the question, so the record has to be repaired while it can be.
UNKNOWN_BLOCKER_STALE_DAYS = 7
# One imperative sentence fits inside this; narrative belongs in the stream.
NEXT_ACTION_BUDGET = 200
# A completed row is dropped this long after merge evidence, so a completed
# stream still in works/ past it has an unfinished archival.
COMPLETED_RETENTION_DAYS = 3
# A work ID is repeated in every state path, source tree path, and branch.
WORK_ID_MAX_BYTES = 32
WORK_ID_SLUG = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
SPECIFICATION_BASE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
INLINE_SPECIFICATION_ID = re.compile(r"^inline-approved:sha256:([0-9a-f]{64})$")
WORK_ID_DATE_PREFIX = re.compile(r"^(?:\d{8}|\d{4}-\d{2}-\d{2}|\d{6})-")
WORK_ID_TYPE_PREFIX = re.compile(
    r"^(?:build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)-"
)
# A base-36 suffix alternates letters and digits; a real word segment keeps
# its digits at one end (`v2`, `p95`, `oauth2`).
WORK_ID_RANDOM_SUFFIX = re.compile(
    r"^(?=[a-z0-9]*[a-z]\d)(?=[a-z0-9]*\d[a-z])[a-z0-9]{5,8}$"
)
CANONICAL_OVERVIEW_SECTIONS = {
    "goal",
    "requirements",
    "awaiting you",
    "state systems",
    "streams",
    "recently landed",
}
OVERVIEW_SIBLINGS = {
    "environment.md": "trees, refs, and gates — dated and re-measurable",
    "traps.md": "symptom → cause → do-this-instead",
}
ISO_DATE = re.compile(r"(\d{4}-\d{2}-\d{2})")
JOURNAL_STATUS_EVENT = re.compile(
    r"^- (\d{4}-\d{2}-\d{2})\S* \S+ rev:\d+ status\b\s*(.*)$"
)
PHASE_ORDER = {name: index for index, name in enumerate(PHASES)}
PHASE_ORDER.update(
    {
        "initialized": PHASE_ORDER["planned"],
        "active": PHASE_ORDER["working"],
        "retiring": PHASE_ORDER["completed"],
    }
)
# A long journal is compacted into numbered segments beside its index, so the
# index's own tail is not the last real event.
JOURNAL_SEGMENT = re.compile(r"^(\d+)-journal[-.]", re.IGNORECASE)
# `completed` is terminal and reachable only on merge evidence: a recorded
# pull request, or the change observed on the default branch. A bare commit
# hash is neither.
MERGE_PR_REFERENCE = re.compile(
    r"(?:\bPR[\s:]*#?\d+\b|(?<![\w/#])#\d+\b|/pull/\d+)"
)
MERGE_BRANCH_EVIDENCE = re.compile(
    r"\bmerge(?:d|s)?\s+(?:into|to)\b|\bmerge[- ]commit\b|"
