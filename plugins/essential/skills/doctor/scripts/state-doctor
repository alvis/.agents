)
LIST_ITEM = re.compile(r"^(\s*)(?:[-+*]|\d+[.)])\s+(.*)$")
OUTLIVES_LABEL = re.compile(r"outlives", re.IGNORECASE)
OWNER_FIELD = re.compile(r"owner\s*:\s*([^|;]*)", re.IGNORECASE)
