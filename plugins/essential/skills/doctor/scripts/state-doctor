SPECIFICATION_DOCUMENTATION_CONTEXT = re.compile(
    r"\b(?:process|guide|guidance|workflow|method|policy|template|overview|index)\b",
    re.IGNORECASE,
)
PROJECT_SPECIFICATION_SCHEME = re.compile(r"^https?://", re.IGNORECASE)
SPECIFICATION_TARGET_SCHEME = re.compile(
    r"^[A-Za-z][A-Za-z0-9+.-]*:",
)
# The flag exists so a reconstructed criterion is never read as an operator
# commitment. At `planned` nothing is being built against the charter yet, so
# `absent` is the honest state; the risk begins the moment work does.
CHARTERED_PHASES = ("working", "reviewing", "completed", "archived")
PARENT_ID = re.compile(r"^[A-Z]{3}$")
CHILD_ID = re.compile(r"^([A-Z]{3})(0[1-9]|[1-9][0-9])$")
